diff --git a/src/api.ts b/src/api.ts
index 4cd5a00..b8737b2 100644
--- a/src/api.ts
+++ b/src/api.ts
@@ -119,10 +119,37 @@ export async function submitDisposition(
   decisionId: number,
   action: DispositionAction,
   reason: string,
+  reasonCode: string,
 ): Promise<DispositionResult> {
   return request<DispositionResult>(`/api/v1/decisions/${decisionId}/disposition`, {
     method: 'POST',
     headers: { 'Content-Type': 'application/json', ...(await authHeaders()) },
-    body: JSON.stringify({ action, reason }),
+    body: JSON.stringify({ action, reason, reason_code: reasonCode }),
+  })
+}
+
+// --- M4 user-study adapter (study/legacy/legacy-adapter.patch) ---------------------------------
+// The API now requires a reason code on every disposition (added after this UI), and the study
+// opens a stored plan by id. Nothing else about this UI is changed.
+
+/** Reason codes accepted by POST /disposition, as served by GET /api/v1/reason-codes. */
+export const REASON_CODES: { value: string; action: DispositionAction; label: string }[] = [
+  { value: 'reviewed_as_proposed', action: 'approve', label: 'Approve: reviewed, right as proposed' },
+  { value: 'accepted_with_known_shortfall', action: 'approve', label: 'Approve: shortfall understood' },
+  { value: 'time_critical', action: 'approve', label: 'Approve: time-critical' },
+  { value: 'eta_incorrect', action: 'reject', label: 'Reject: an ETA is wrong' },
+  { value: 'unit_unavailable_or_unknown', action: 'reject', label: 'Reject: a unit is unavailable or does not exist' },
+  { value: 'incident_missing_or_wrong', action: 'reject', label: 'Reject: an incident is missing or wrong' },
+  { value: 'constraint_not_honoured', action: 'reject', label: 'Reject: a constraint is not honoured' },
+  { value: 'sitrep_numbers_wrong', action: 'reject', label: 'Reject: SITREP numbers do not match the plan' },
+  { value: 'better_plan_needed', action: 'reject', label: 'Reject: a better allocation is needed' },
+  { value: 'situation_changed', action: 'reject', label: 'Reject: the situation has changed' },
+  { value: 'other', action: 'reject', label: 'Reject: other (explain in the reason)' },
+]
+
+/** A stored plan (GET /api/v1/decisions/{id}); the same shape POST /decisions returns. */
+export async function fetchStoredDecision(decisionId: number): Promise<Decision & { scenario: Scenario }> {
+  return request<Decision & { scenario: Scenario }>(`/api/v1/decisions/${decisionId}`, {
+    headers: { ...(await authHeaders()) },
   })
 }
