# Runtime mode. Never place credentials or production values in this file.
AEGISOPS_ENVIRONMENT=development
AEGISOPS_DEBUG=true

# Comma-separated explicit browser origins. Wildcard origins are rejected unless debug is enabled.
AEGISOPS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Security settings
SECRET_KEY=your_secret_key_here

# Rate limiting
RATE_LIMIT=100/minute